# Cloudflare Pages 响应头
# CSP 按《建站结账页契约》§7.1 方案 A：
#   · script-src 只有 'unsafe-inline'，绝不与 nonce/hash 共存
#   · base-uri 'self'：connector 往验证弹层注入 <base href="/bp/3ds/"> 需要它
#   · connect-src 放行面板域（https + wss）
#   · 不发 sandbox / Trusted Types / X-Frame-Options: DENY

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://annangourmet.makeup wss://annangourmet.makeup; frame-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(self), clipboard-write=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/c/*
  Cache-Control: public, max-age=0, must-revalidate

/checkout
  Cache-Control: no-store

/checkout/*
  Cache-Control: no-store

/data/*
  Cache-Control: public, max-age=600

/bp/*
  Cache-Control: public, max-age=300
